# DocTender Environment Variables

# Python
PYTHONUNBUFFERABLE=1
PYTHON_ENV=production

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/doctender

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Batch Processing
MAX_BATCH_SIZE=1000
BATCH_TIMEOUT=3600

# Caching
CACHE_ENABLED=true
CACHE_TTL=3600

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Security
SECRET_KEY=your-secret-key-here
API_KEY=your-api-key-here

# Features
ENABLE_BATCH_PROCESSING=true
ENABLE_CACHING=true
ENABLE_MONITORING=true
